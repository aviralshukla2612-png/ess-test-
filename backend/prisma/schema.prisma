generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         String     @default("ADMIN")
  isActive     Boolean    @default(true)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

model Candidate {
  id               String              @id @default(uuid())
  enrollmentNumber String              @unique
  candidateId      String              @unique
  fullName         String
  email            String              @unique
  phone            String
  collegeName      String
  university       String
  degree           String
  branch           String
  semester         String
  graduationYear   String
  cgpa             String?
  attempts         AssessmentAttempt[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([email])
  @@index([enrollmentNumber])
  @@index([collegeName])
}

model Question {
  id            String             @id @default(uuid())
  section       String             // MATHEMATICS, LOGICAL_REASONING, DEVELOPER_TECHNICAL
  topic         String?
  question      String
  optionsJson   String             // JSON stringified array of options [{id: "A", text: "..."}] or ["A", "B", "C", "D"]
  correctAnswer String
  difficulty    String             @default("MEDIUM") // EASY, MEDIUM, HARD
  timeLimit     Int                @default(60)       // Duration in seconds
  isActive      Boolean            @default(true)
  answers       AssessmentAnswer[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([section])
  @@index([difficulty])
  @@index([isActive])
}

model AssessmentConfiguration {
  id                   String   @id @default(uuid())
  version              Int      @unique @default(1)
  name                 String   @default("Emperor Pre-Employment Evaluation")
  isActive             Boolean  @default(true)
  mathQuestionIds      String   // JSON array of 5 question IDs
  reasoningQuestionIds String   // JSON array of 5 question IDs
  developerQuestionIds String   // JSON array of 5 question IDs
  totalQuestions       Int      @default(15)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AssessmentAttempt {
  id                   String             @id @default(uuid())
  candidateId          String
  candidate            Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentVersion    Int                @default(1)
  snapshotQuestions    String             // JSON snapshot of the 15 locked questions for this attempt
  currentQuestionIndex Int                @default(0)
  startedAt            DateTime           @default(now())
  questionStartedAt    DateTime           @default(now())
  completedAt          DateTime?
  status               String             @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, COMPLETED, EXPIRED
  score                Int                @default(0)
  percentage           Float              @default(0.0)
  totalSecondsSpent    Int                @default(0)
  tabSwitchCount       Int                @default(0)
  typingResultJson     String?            // JSON of typing metrics: { wpm, accuracy, grade, wordsTyped }
  answers              AssessmentAnswer[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([candidateId])
  @@index([status])
}

model AssessmentAnswer {
  id             String            @id @default(uuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question          @relation(fields: [questionId], references: [id])
  selectedAnswer String?
  correctAnswer  String
  isCorrect      Boolean           @default(false)
  timeSpent      Int               @default(0)
  isTimeout      Boolean           @default(false)
  answeredAt     DateTime          @default(now())

  @@index([attemptId])
  @@index([questionId])
}

model AuditLog {
  id         String     @id @default(uuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String     // e.g. "ADMIN_LOGIN", "QUESTION_CREATED", "ASSESSMENT_CONFIGURED"
  entityType String?    // e.g. "Question", "Assessment", "Candidate"
  entityId   String?
  metadata   String?    // JSON stringified context
  createdAt  DateTime   @default(now())

  @@index([action])
  @@index([createdAt])
}
